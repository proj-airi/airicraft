{
	"schemaVersion": 1,
	"id": "airicraft-evaluator",
	"version": "${version}",
	"name": "Airicraft Evaluator",
	"description": "Optional scenario evaluation addon for Airicraft.",
	"authors": [
		"Airicraft"
	],
	"license": "CC0-1.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"ai.moeru.airicraft.evaluator.AiricraftEvaluatorClient"
		]
