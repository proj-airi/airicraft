#!/usr/bin/env python3
"""Bootstrap Airicraft evaluator scenarios and leave durable reports to the addon."""

from __future__ import annotations

import argparse
import concurrent.futures
import hashlib
import json
import os
import queue
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import uuid
import urllib.error
import urllib.request
import zipfile
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable, Mapping


TERMINAL_STATUSES = {"PASSED", "FAILED", "NEEDS_REVIEW"}
BRIDGE_STATE_ENVIRONMENT_VARIABLE = "AIRICRAFT_BRIDGE_STATE_FILE"
EVALUATOR_GAME_DIR_ENVIRONMENT_VARIABLE = "AIRICRAFT_EVALUATOR_GAME_DIR"
EVALUATOR_JDWP_ENVIRONMENT_VARIABLE = "AIRICRAFT_EVALUATOR_JDWP_ENABLED"
EVALUATOR_PREPARED_ENVIRONMENT_VARIABLE = "AIRICRAFT_EVALUATOR_RUNTIME_PREPARED"
EVALUATOR_SCENARIO_MANIFEST_ENVIRONMENT_VARIABLE = "AIRICRAFT_EVALUATOR_SCENARIO_MANIFEST"
EVALUATOR_PLAYER_NAME_ENVIRONMENT_VARIABLE = "AIRICRAFT_EVALUATOR_PLAYER_NAME"
RECORDER_JAR_ENVIRONMENT_VARIABLE = "AIRICRAFT_RECORDER_JAR"
RECORDER_EVENTS_RELATIVE_PATH = Path("capture/events.jsonl")
RECORDER_REPLAY_RELATIVE_PATH = Path("capture/replay.zip")
RECORDER_REPLAY_FORMAT = "flashback"
PLANNER_CALLS_FILE_NAME = "planner-calls.jsonl"
PLANNER_EXTENSION_TYPE = "airicraft.planner"
PLANNER_CALL_SCHEMA = "airicraft.planner-call.v1"
SENSITIVE_KEY_RE = re.compile(r"(token|authorization|api[_-]?key|secret|password|credential)", re.IGNORECASE)
BEARER_RE = re.compile(r"Bearer\s+[A-Za-z0-9._~+/=-]+", re.IGNORECASE)
JSON_SECRET_RE = re.compile(
    r'("?(?:token|authorization|api[_-]?key|secret|password|credential)"?\s*[:=]\s*)("[^"]*"|[^\s,}]+)',
    re.IGNORECASE,
)


class RunnerError(RuntimeError):
    pass


class BridgeHttpError(RunnerError):
    def __init__(self, method: str, path: str, status: int, payload: Any) -> None:
        super().__init__(f"{method} {path} failed with HTTP {status}")
        self.method = method
        self.path = path
        self.status = status
        self.payload = payload


@dataclass(frozen=True)
class RecorderOptions:
    enabled: bool
    profile: str | None


@dataclass(frozen=True)
class BridgeState:
    port: int
    token: str
    started_at_epoch_millis: int
    process_id: int

    @property
    def base_url(self) -> str:
        return f"http://127.0.0.1:{self.port}"


@dataclass
class ClientProcess:
    process: subprocess.Popen[str]
    log_path: Path
    log_thread: threading.Thread | None
    line_queue: "queue.Queue[str]"
    log_handle: Any | None
    output_detached: bool


@dataclass(frozen=True)
class ScenarioWorker:
    index: int
    worker_id: str
    scenario: dict[str, Any]
    scenario_dir: Path
    worker_dir: Path
    game_dir: Path
    bridge_state_path: Path


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def local_timestamp() -> str:
    return datetime.now().strftime("%Y%m%d-%H%M%S-%f") + f"-{os.getpid()}"


def repo_root_from_script() -> Path:
    return Path(__file__).resolve().parents[1]


def default_client_command(repo_root: Path) -> str:
    return "scripts/eval run --no-daemon"


def read_bridge_state(path: Path) -> BridgeState | None:
    if not path.exists():
        return None
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
        return BridgeState(
            port=int(raw["port"]),
            token=str(raw["token"]),
            started_at_epoch_millis=int(raw["startedAtEpochMillis"]),
            process_id=int(raw.get("processId", -1)),
        )
    except Exception:
        return None


def redact_text(value: str) -> str:
    value = BEARER_RE.sub("Bearer [REDACTED]", value)
    return JSON_SECRET_RE.sub(lambda match: f"{match.group(1)}[REDACTED]", value)


def redact_json(value: Any) -> Any:
    if isinstance(value, dict):
        redacted: dict[str, Any] = {}
        for key, child in value.items():
            if SENSITIVE_KEY_RE.search(str(key)):
                redacted[key] = "[REDACTED]"
            else:
                redacted[key] = redact_json(child)
        return redacted
    if isinstance(value, list):
        return [redact_json(child) for child in value]
    if isinstance(value, str):
        return redact_text(value)
    return value


def write_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(redact_json(payload), indent=2, sort_keys=True) + "\n", encoding="utf-8")


def append_jsonl(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(redact_json(payload), sort_keys=True) + "\n")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def safe_name(value: str) -> str:
    safe = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip())
    safe = re.sub(r"(^[-.]+|[-.]+$)", "", safe)
    return safe or "scenario"


def positive_int(value: str) -> int:
    parsed = int(value)
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return parsed


def resolve_recorder_options(
    command_profile: str | None,
    no_recorder: bool,
    environment: Mapping[str, str],
) -> RecorderOptions:
    if no_recorder and command_profile is not None:
        raise RunnerError("--no-recorder cannot be combined with --recorder-jar")
    if no_recorder:
        return RecorderOptions(False, None)

    profile = command_profile if command_profile is not None else environment.get(RECORDER_JAR_ENVIRONMENT_VARIABLE)
    if profile is None or not profile.strip():
        raise RunnerError("Recorder-enabled runs need --recorder-jar or AIRICRAFT_RECORDER_JAR")
    return RecorderOptions(True, profile.strip())


def effective_worker_count(jobs: int, scenario_count: int) -> int:
    if jobs < 1:
        raise ValueError("jobs must be at least 1")
    return min(jobs, scenario_count) if scenario_count > 0 else 0


def snapshot_evaluator_game_directory(repo_root: Path, worker_root: Path) -> Path:
    source_root = repo_root / "run"
    seed_dir = worker_root / ".seed"
    seed_dir.mkdir(parents=True, exist_ok=False)
    for relative in (Path("config"), Path("journeymap/config")):
        source = source_root / relative
        if source.is_dir():
            shutil.copytree(source, seed_dir / relative)
    options_file = source_root / "options.txt"
    if options_file.is_file():
        destination = seed_dir / "options.txt"
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(options_file, destination)
    return seed_dir


def prepare_worker_directory(seed_dir: Path, worker_dir: Path) -> Path:
    game_dir = worker_dir / "game"
    shutil.copytree(seed_dir, game_dir)
    return game_dir


def prepare_recorder_game_directory(game_dir: Path, artifact_root: Path) -> None:
    artifact_root = artifact_root.resolve()
    game_dir = game_dir.resolve()
    recorder_config = {
        "artifacts_root": str(artifact_root),
        "server_name": "airicraft-evaluation",
        "server_instance_id": str(uuid.uuid4()),
        "record_all_players": True,
        "writer_queue_capacity": 65_536,
        "include_inventory_components": True,
    }
    server_replay_config = {
        "allow_downloading_replays": False,
        "automatically_record": True,
        "chunk_recorder_load_radius": -1,
        "chunk_recording_path": str(artifact_root / "server-replay" / "chunks"),
        "chunk_recording_strategy": "always",
        "chunks": [],
        "default_encoding": RECORDER_REPLAY_FORMAT,
        "delete_replays_after_duration": "0s",
        "ignore_action_bar_packets": False,
        "ignore_chat_packets": True,
        "ignore_custom_payloads": False,
        "ignore_light_packets": False,
        "ignore_scoreboard_packets": False,
        "ignore_sound_packets": False,
        "include_resource_packs": True,
        "log_deleted_replays": True,
        "max_duration": "0s",
        "max_file_size": "0 B",
        "notify_admins_of_status": True,
        "optimize_entity_packets": False,
        "optimize_explosion_packets": True,
        "pause_notify_players": False,
        "player_predicate": {"type": "all"},
        "player_recording_name": "{uuid}",
        "player_recording_path": str(artifact_root / "server-replay" / "players"),
        "record_hotbar": True,
        "record_voice_chat": False,
        "recover_unsaved_replays": True,
        "replay_server_ip": None,
        "restart_after_max_duration": False,
        "restart_after_max_file_size": False,
        "server_name": "airicraft-evaluation",
        "world_name": "airicraft-evaluation",
    }
    write_json(game_dir / "config" / "recorder-minecraft.json", recorder_config)
    write_json(game_dir / "config" / "server-replay" / "config.json", server_replay_config)


def worker_plans(
    run_dir: Path,
    worker_root: Path,
    seed_dir: Path,
    scenarios: list[dict[str, Any]],
) -> list[ScenarioWorker]:
    plans: list[ScenarioWorker] = []
    for index, scenario in enumerate(scenarios, start=1):
        scenario_id = str(scenario["id"])
        name = f"{index:02d}-{safe_name(scenario_id)}"
        worker_dir = worker_root / name
        game_dir = prepare_worker_directory(seed_dir, worker_dir)
        scenario_dir = run_dir / name
        plans.append(ScenarioWorker(
            index=index,
            worker_id=f"worker-{index:02d}",
            scenario=scenario,
            scenario_dir=scenario_dir,
            worker_dir=worker_dir,
            game_dir=game_dir,
            bridge_state_path=scenario_dir / "bridge-state.json",
        ))
    return plans


def should_delete_worker(summary: dict[str, Any]) -> bool:
    return (
        summary.get("harnessStatus") == "OK"
        and summary.get("reportStatus") == "PASSED"
        and not summary.get("clientKeptRunning", False)
    )


def is_finalized_recorder_play(play_dir: Path) -> bool:
    metadata_path = play_dir / "metadata.json"
    events_path = play_dir / RECORDER_EVENTS_RELATIVE_PATH
    replay_path = play_dir / RECORDER_REPLAY_RELATIVE_PATH
    try:
        if not metadata_path.is_file() or not events_path.is_file() or not replay_path.is_file():
            return False
        if events_path.stat().st_size == 0:
            return False
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    if not isinstance(metadata, dict):
        return False
    connection = metadata.get("connection", {})
    capture = metadata.get("capture", {})
    if not isinstance(connection, dict) or not isinstance(capture, dict):
        return False
    if not connection.get("endedAt") or connection.get("endServerTick") is None:
        return False
    if (
        capture.get("events") != RECORDER_EVENTS_RELATIVE_PATH.as_posix()
        or capture.get("replay") != RECORDER_REPLAY_RELATIVE_PATH.as_posix()
        or capture.get("replayFormat") != RECORDER_REPLAY_FORMAT
    ):
        return False
    try:
        with zipfile.ZipFile(replay_path) as replay:
            if replay.testzip() is not None:
                return False
            return any(name.lower().endswith(".flashback") for name in replay.namelist())
    except (OSError, zipfile.BadZipFile):
        return False


def recorder_play_player_uuid(play_dir: Path) -> str | None:
    try:
        metadata = json.loads((play_dir / "metadata.json").read_text(encoding="utf-8"))
        return str(uuid.UUID(str(metadata["player"]["uuid"])))
    except (OSError, ValueError, KeyError, TypeError):
        return None


def discover_finalized_recorder_play(recorder_root: Path, player_uuid: str | None = None) -> Path | None:
    """Find the one finalized Play; with several connected players, only `player_uuid`'s Play counts."""
    if not recorder_root.is_dir():
        return None
    wanted = str(uuid.UUID(player_uuid)) if player_uuid else None
    plays = [
        metadata_path.parent
        for metadata_path in recorder_root.rglob("metadata.json")
        if is_finalized_recorder_play(metadata_path.parent)
        and (wanted is None or recorder_play_player_uuid(metadata_path.parent) == wanted)
    ]
    owner = "" if wanted is None else f" for player {wanted}"
    if len(plays) > 1:
        raise RunnerError(f"expected one finalized Recorder Play{owner}, found {len(plays)}")
    return plays[0] if plays else None


def publish_planner_extension(scenario_dir: Path, recorder_play: Path) -> bool:
    source = scenario_dir / PLANNER_CALLS_FILE_NAME
    if not source.is_file() or source.stat().st_size == 0:
        return False
    try:
        metadata = json.loads((recorder_play / "metadata.json").read_text(encoding="utf-8"))
        records = [
            json.loads(line)
            for line in source.read_text(encoding="utf-8").splitlines()
            if line.strip()
        ]
    except (OSError, json.JSONDecodeError) as error:
        raise RunnerError(f"invalid {PLANNER_CALLS_FILE_NAME}: {error}") from error
    if not records:
        return False

    server = required_mapping(metadata, "server", "Recorder metadata")
    player = required_mapping(metadata, "player", "Recorder metadata")
    connection = required_mapping(metadata, "connection", "Recorder metadata")
    server_instance_id = required_string(server, "instanceId", "Recorder metadata server")
    player_uuid = required_string(player, "uuid", "Recorder metadata player")
    connection_id = required_string(connection, "id", "Recorder metadata connection")
    start_tick = metadata_tick(connection, "startServerTick")
    end_tick = metadata_tick(connection, "endServerTick")
    validate_planner_call_records(records, start_tick, end_tick)

    extension_parent = recorder_play / "extensions"
    extension_dir = extension_parent / PLANNER_EXTENSION_TYPE
    temporary_dir = extension_parent / f".{PLANNER_EXTENSION_TYPE}.inprogress-{uuid.uuid4()}"
    temporary_dir.mkdir(parents=True)
    try:
        shutil.copyfile(source, temporary_dir / PLANNER_CALLS_FILE_NAME)
        write_json(temporary_dir / "manifest.json", {
            "manifestVersion": 1,
            "extensionType": PLANNER_EXTENSION_TYPE,
            "play": {
                "serverInstanceId": server_instance_id,
                "playerUuid": player_uuid,
                "connectionId": connection_id,
            },
            "timeDomain": "PLAY_EXTENSION_TIME_DOMAIN_SERVER_TICK",
            "assets": [{
                "role": "planner_calls",
                "path": PLANNER_CALLS_FILE_NAME,
                "mediaType": "application/x-ndjson",
                "schema": PLANNER_CALL_SCHEMA,
            }],
        })
        if extension_dir.exists():
            shutil.rmtree(extension_dir)
        temporary_dir.replace(extension_dir)
    except Exception:
        if temporary_dir.exists():
            shutil.rmtree(temporary_dir)
        raise
    return True


def validate_planner_call_records(records: list[Any], start_tick: int, end_tick: int) -> None:
    expected_sequence = 1
    call_ids: set[str] = set()
    for line_number, record in enumerate(records, start=1):
        context = f"{PLANNER_CALLS_FILE_NAME} line {line_number}"
        if not isinstance(record, dict) or record.get("schemaVersion") != 1:
            raise RunnerError(f"{context} does not match {PLANNER_CALL_SCHEMA}")
        call_id = required_string(record, "callId", context)
        if call_id in call_ids:
            raise RunnerError(f"{context} repeats callId {call_id}")
        call_ids.add(call_id)
        sequence = decimal_string(record.get("sequence"), f"{context} sequence")
        if sequence != expected_sequence:
            raise RunnerError(f"{context} sequence must be {expected_sequence}")
        expected_sequence += 1

        timeline = required_mapping(record, "timeline", context)
        submitted = planner_anchor_tick(timeline, "submitted", context)
        completed = planner_anchor_tick(timeline, "completed", context)
        applied = planner_anchor_tick(timeline, "applied", context, required=False)
        if completed < submitted or (applied is not None and applied < completed):
            raise RunnerError(f"{context} timeline ticks are not ordered")
        for tick in (submitted, completed, applied):
            if tick is not None and not start_tick <= tick <= end_tick:
                raise RunnerError(
                    f"{context} serverTick {tick} is outside Play range {start_tick}..{end_tick}"
                )


def planner_anchor_tick(
    timeline: dict[str, Any],
    name: str,
    context: str,
    required: bool = True,
) -> int | None:
    anchor = timeline.get(name)
    if anchor is None and not required:
        return None
    if not isinstance(anchor, dict):
        raise RunnerError(f"{context} timeline.{name} must be an object")
    return decimal_string(anchor.get("serverTick"), f"{context} timeline.{name}.serverTick")


def required_mapping(value: Any, key: str, context: str) -> dict[str, Any]:
    child = value.get(key) if isinstance(value, dict) else None
    if not isinstance(child, dict):
        raise RunnerError(f"{context} {key} must be an object")
    return child


def required_string(value: dict[str, Any], key: str, context: str) -> str:
    child = value.get(key)
    if not isinstance(child, str) or not child.strip():
        raise RunnerError(f"{context} {key} must be a non-empty string")
    return child


def decimal_string(value: Any, context: str) -> int:
    if not isinstance(value, str) or re.fullmatch(r"0|[1-9][0-9]*", value) is None:
        raise RunnerError(f"{context} must be a non-negative decimal string")
    return int(value)


def metadata_tick(connection: dict[str, Any], key: str) -> int:
    value = connection.get(key)
    if isinstance(value, bool) or not isinstance(value, (int, str)):
        raise RunnerError(f"Recorder metadata connection {key} must be an integer")
    try:
        tick = int(value)
    except ValueError as error:
        raise RunnerError(f"Recorder metadata connection {key} must be an integer") from error
    if tick < 0:
        raise RunnerError(f"Recorder metadata connection {key} must not be negative")
    return tick


def finalize_recorder_capture(
    summary: dict[str, Any],
    scenario_dir: Path,
    recorder_root: Path,
    player_uuid: str | None = None,
) -> None:
    summary["recorderPlayPath"] = None
    try:
        recorder_play = discover_finalized_recorder_play(recorder_root, player_uuid)
    except RunnerError as error:
        recorder_play = None
        if summary.get("harnessStatus") != "INTERRUPTED":
            summary["message"] = f"Recorder capture failed: {error}"
    if recorder_play is None:
        if summary.get("harnessStatus") != "INTERRUPTED":
            summary["harnessStatus"] = "CAPTURE_ERROR"
            if summary.get("message") is None:
                owner = f" for player {player_uuid}" if player_uuid else ""
                summary["message"] = f"Recorder capture failed: no finalized Recorder Play found{owner}"
    else:
        summary["recorderPlayPath"] = recorder_play.resolve().relative_to(scenario_dir.resolve()).as_posix()
        try:
            publish_planner_extension(scenario_dir, recorder_play)
        except (OSError, RunnerError) as error:
            if summary.get("harnessStatus") != "INTERRUPTED":
                summary["harnessStatus"] = "CAPTURE_ERROR"
                summary["message"] = f"Recorder planner extension failed: {error}"


def ordered_results(results_by_index: dict[int, dict[str, Any]]) -> list[dict[str, Any]]:
    return [results_by_index[index] for index in sorted(results_by_index)]


def cancelled_worker_result(worker: ScenarioWorker, recorder_enabled: bool = False) -> dict[str, Any]:
    worker.scenario_dir.mkdir(parents=True, exist_ok=True)
    summary = {
        "id": str(worker.scenario["id"]),
        "name": worker.scenario.get("name"),
        "index": worker.index,
        "workerId": worker.worker_id,
        "startedAt": None,
        "finishedAt": utc_now_iso(),
        "harnessStatus": "INTERRUPTED",
        "reportStatus": None,
        "message": "Cancelled before client launch",
        "interrupted": True,
        "workerDir": str(worker.worker_dir),
        "gameDir": str(worker.game_dir),
        "bridgeStatePath": str(worker.bridge_state_path),
        "clientKeptRunning": False,
        "workerDirectoryCleanup": "RETAINED",
    }
    if recorder_enabled:
        summary["recorderPlayPath"] = None
    write_json(worker.scenario_dir / "harness-summary.json", summary)
    return summary


def failed_worker_result(
    worker: ScenarioWorker,
    error: BaseException,
    recorder_enabled: bool = False,
) -> dict[str, Any]:
    worker.scenario_dir.mkdir(parents=True, exist_ok=True)
    summary = {
        "id": str(worker.scenario["id"]),
        "name": worker.scenario.get("name"),
        "index": worker.index,
        "workerId": worker.worker_id,
        "startedAt": None,
        "finishedAt": utc_now_iso(),
        "harnessStatus": "HARNESS_ERROR",
        "reportStatus": None,
        "message": f"{type(error).__name__}: {error}",
        "workerDir": str(worker.worker_dir),
        "gameDir": str(worker.game_dir),
        "bridgeStatePath": str(worker.bridge_state_path),
        "clientKeptRunning": False,
        "workerDirectoryCleanup": "RETAINED",
    }
    if recorder_enabled:
        summary["recorderPlayPath"] = None
    write_json(worker.scenario_dir / "harness-summary.json", summary)
    return summary


def client_environment(
    bridge_state_path: Path,
    game_dir: Path,
    worker_id: str,
    runtime_prepared: bool,
    recorder_options: RecorderOptions,
    source_environment: Mapping[str, str] | None = None,
    scenario_manifest: Path | None = None,
) -> dict[str, str]:
    environment = dict(os.environ if source_environment is None else source_environment)
    environment[BRIDGE_STATE_ENVIRONMENT_VARIABLE] = str(bridge_state_path.resolve())
    environment[EVALUATOR_GAME_DIR_ENVIRONMENT_VARIABLE] = str(game_dir.resolve())
    environment[EVALUATOR_JDWP_ENVIRONMENT_VARIABLE] = "false"
    environment[EVALUATOR_PREPARED_ENVIRONMENT_VARIABLE] = str(runtime_prepared).lower()
    if scenario_manifest is None:
        environment.pop(EVALUATOR_SCENARIO_MANIFEST_ENVIRONMENT_VARIABLE, None)
    else:
        environment[EVALUATOR_SCENARIO_MANIFEST_ENVIRONMENT_VARIABLE] = str(scenario_manifest.resolve())
    player_suffix = re.sub(r"[^A-Za-z0-9_]", "", worker_id)[-8:]
    environment[EVALUATOR_PLAYER_NAME_ENVIRONMENT_VARIABLE] = "AirEval" + player_suffix
    if recorder_options.enabled:
        if recorder_options.profile is None:
            raise RunnerError("Recorder-enabled runs need a recording profile")
        environment[RECORDER_JAR_ENVIRONMENT_VARIABLE] = recorder_options.profile
    else:
        environment.pop(RECORDER_JAR_ENVIRONMENT_VARIABLE, None)
    return environment


def start_client(
    repo_root: Path,
    command: str,
    log_path: Path,
    bridge_state_path: Path,
    game_dir: Path,
    worker_id: str,
    runtime_prepared: bool,
    recorder_options: RecorderOptions,
    detach_output: bool = False,
    scenario_manifest: Path | None = None,
) -> ClientProcess:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    bridge_state_path.parent.mkdir(parents=True, exist_ok=True)
    line_queue: "queue.Queue[str]" = queue.Queue()
    log_handle = None
    environment = client_environment(
        bridge_state_path,
        game_dir,
        worker_id,
        runtime_prepared,
        recorder_options,
        scenario_manifest=scenario_manifest,
    )
    if detach_output:
        log_handle = log_path.open("a", encoding="utf-8")
        process = subprocess.Popen(
            ["bash", "-lc", command],
            cwd=repo_root,
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            start_new_session=True,
            env=environment,
        )
        return ClientProcess(
            process=process,
            log_path=log_path,
            log_thread=None,
            line_queue=line_queue,
            log_handle=log_handle,
            output_detached=True,
        )

    process = subprocess.Popen(
        ["bash", "-lc", command],
        cwd=repo_root,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        start_new_session=True,
        env=environment,
    )

    def pump() -> None:
        assert process.stdout is not None
        with log_path.open("a", encoding="utf-8") as handle:
            for line in process.stdout:
                redacted = redact_text(line)
                handle.write(redacted)
                handle.flush()
                line_queue.put(redacted.rstrip("\n"))

    thread = threading.Thread(target=pump, name="airicraft-client-log", daemon=True)
    thread.start()
    return ClientProcess(
        process=process,
        log_path=log_path,
        log_thread=thread,
        line_queue=line_queue,
        log_handle=None,
        output_detached=False,
    )


def close_parent_log_handle(client: ClientProcess) -> None:
    if client.log_handle is not None and not client.log_handle.closed:
        client.log_handle.close()


def process_group_alive(process_group_id: int) -> bool:
    try:
        os.killpg(process_group_id, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def wait_for_process_group_exit(process: subprocess.Popen[str], timeout_seconds: float) -> bool:
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        process.poll()
        if not process_group_alive(process.pid):
            return True
        time.sleep(0.1)
    process.poll()
    return not process_group_alive(process.pid)


def process_alive(process_id: int) -> bool:
    if process_id < 1:
        return False
    try:
        os.kill(process_id, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def wait_for_process_exit(process_id: int, timeout_seconds: float) -> bool:
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        if not process_alive(process_id):
            return True
        time.sleep(0.1)
    return not process_alive(process_id)


def stop_client(
    client: ClientProcess,
    timeout_seconds: float,
    minecraft_process_id: int = -1,
    graceful_stop: Callable[[], None] | None = None,
) -> dict[str, Any]:
    process = client.process
    result: dict[str, Any] = {
        "requestedAt": utc_now_iso(),
        "pid": process.pid,
        "minecraftProcessId": minecraft_process_id,
        "initialReturnCode": process.poll(),
        "method": None,
    }
    graceful_stop_completed = False
    if graceful_stop is not None and (process.poll() is None or process_group_alive(process.pid)):
        result["method"] = "BRIDGE"
        try:
            graceful_stop()
            graceful_stop_completed = wait_for_process_group_exit(process, timeout_seconds)
        except Exception as error:
            result["gracefulStopError"] = endpoint_error(error)
    if not graceful_stop_completed and (process.poll() is None or process_group_alive(process.pid)):
        result["method"] = "SIGINT"
        try:
            os.killpg(process.pid, signal.SIGINT)
        except ProcessLookupError:
            pass
        if not wait_for_process_group_exit(process, timeout_seconds):
            result["method"] = "SIGTERM"
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            if not wait_for_process_group_exit(process, 10):
                result["method"] = "SIGKILL"
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                wait_for_process_group_exit(process, 10)
    if process_alive(minecraft_process_id) and not wait_for_process_exit(minecraft_process_id, timeout_seconds):
        result["minecraftMethod"] = "SIGINT"
        try:
            os.kill(minecraft_process_id, signal.SIGINT)
        except ProcessLookupError:
            pass
        if not wait_for_process_exit(minecraft_process_id, 10):
            result["minecraftMethod"] = "SIGTERM"
            try:
                os.kill(minecraft_process_id, signal.SIGTERM)
            except ProcessLookupError:
                pass
            if not wait_for_process_exit(minecraft_process_id, 10):
                result["minecraftMethod"] = "SIGKILL"
                try:
                    os.kill(minecraft_process_id, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                wait_for_process_exit(minecraft_process_id, 10)
    result["minecraftExited"] = not process_alive(minecraft_process_id)
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass
    if client.log_thread is not None:
        client.log_thread.join(timeout=5)
    close_parent_log_handle(client)
    result["finalReturnCode"] = process.poll()
    result["finishedAt"] = utc_now_iso()
    return result


def leave_client_running(client: ClientProcess) -> dict[str, Any]:
    process = client.process
    result: dict[str, Any] = {
        "requestedAt": utc_now_iso(),
        "pid": process.pid,
        "initialReturnCode": process.poll(),
        "method": "LEFT_RUNNING" if process.poll() is None else "ALREADY_EXITED",
        "finalReturnCode": process.poll(),
        "logPath": str(client.log_path),
        "outputDetached": client.output_detached,
    }
    close_parent_log_handle(client)
    result["finishedAt"] = utc_now_iso()
    return result


def bridge_json(
    bridge: BridgeState,
    method: str,
    path: str,
    payload: Any | None = None,
    timeout_seconds: float = 10,
) -> Any:
    body = None
    headers = {
        "Authorization": f"Bearer {bridge.token}",
        "Accept": "application/json",
    }
    if payload is not None:
        body = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(
        bridge.base_url + path,
        data=body,
        headers=headers,
        method=method,
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
            raw = response.read().decode("utf-8")
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as error:
        raw = error.read().decode("utf-8", errors="replace")
        try:
            parsed: Any = json.loads(raw)
        except json.JSONDecodeError:
            parsed = {"raw": raw}
        raise BridgeHttpError(method, path, error.code, parsed) from error


def endpoint_error(error: BaseException) -> dict[str, Any]:
    if isinstance(error, BridgeHttpError):
        return {
            "ok": False,
            "status": error.status,
            "method": error.method,
            "path": error.path,
            "payload": error.payload,
            "error": str(error),
        }
    return {"ok": False, "error": f"{type(error).__name__}: {error}"}


def wait_for_title_bridge(
    client: ClientProcess,
    bridge_state_path: Path,
    launch_started_ms: int,
    timeout_seconds: float,
    cancellation: threading.Event | None = None,
) -> tuple[BridgeState, dict[str, Any]]:
    deadline = time.monotonic() + timeout_seconds
    last_error: str | None = None
    while time.monotonic() < deadline:
        if cancellation is not None and cancellation.is_set():
            raise RunnerError("cancelled while waiting for bridge")
        if client.process.poll() is not None:
            raise RunnerError(f"client exited while waiting for bridge, code={client.process.poll()}")
        bridge = read_bridge_state(bridge_state_path)
        if bridge is not None and bridge.started_at_epoch_millis >= launch_started_ms - 5000:
            try:
                status = bridge_json(bridge, "GET", "/v1/status", timeout_seconds=2)
                if (
                    status.get("bridgeAvailable")
                    and not status.get("worldLoaded")
                    and status.get("canJoinWorldOrServer")
                ):
                    return bridge, status
                last_error = f"bridge not ready: {status}"
            except Exception as error:
                last_error = f"{type(error).__name__}: {error}"
        time.sleep(1)
    raise RunnerError(f"timed out waiting for title-screen bridge; last_error={last_error}")


def scenario_archive_metadata(scenario_root: Path, scenario: dict[str, Any]) -> dict[str, Any]:
    scenario_id = str(scenario.get("id", ""))
    archive_name = str(scenario.get("worldArchive", "world.zip"))
    archive = scenario_root / safe_name(scenario_id).lower() / archive_name
    payload: dict[str, Any] = {
        "path": str(archive),
        "exists": archive.exists(),
    }
    if archive.exists():
        payload["sizeBytes"] = archive.stat().st_size
        payload["sha256"] = sha256_file(archive)
    return payload


def copy_scenario_config(scenario_root: Path, scenario_id: str, destination: Path) -> None:
    source = scenario_root / safe_name(scenario_id).lower() / "scenario.yml"
    if source.exists():
        shutil.copy2(source, destination)


def selected_scenarios(scenarios: list[dict[str, Any]], filters: list[str] | None) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    requested = {item.strip() for item in filters or [] if item.strip()}
    unknown = sorted(requested - {str(scenario.get("id", "")) for scenario in scenarios})
    if unknown:
        raise RunnerError("unknown scenario filter(s): " + ", ".join(unknown))

    selected: list[dict[str, Any]] = []
    skipped: list[dict[str, Any]] = []
    for scenario in scenarios:
        scenario_id = str(scenario.get("id", ""))
        if requested and scenario_id not in requested:
            continue
        if not scenario.get("promptConfigured", False):
            skipped.append({
                "id": scenario_id,
                "name": scenario.get("name"),
                "reason": "empty_prompt",
            })
            continue
        selected.append(scenario)
    return selected, skipped


def keep_client_for_scenario(
    args: argparse.Namespace,
    index: int,
    total: int,
    recorder_enabled: bool = False,
) -> bool:
    return not recorder_enabled and not args.stop_client_after_scenario and index == total


def discover_scenarios(
    repo_root: Path,
    run_dir: Path,
    client_command: str,
    args: argparse.Namespace,
    worker_dir: Path,
    game_dir: Path,
    recorder_options: RecorderOptions,
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    launch_started_ms = int(time.time() * 1000)
    bridge_state_path = run_dir / "discovery-bridge-state.json"
    if recorder_options.enabled:
        prepare_recorder_game_directory(game_dir, run_dir / "discovery" / "recorder")
    client = start_client(
        repo_root,
        client_command,
        run_dir / "discovery-client.log",
        bridge_state_path,
        game_dir,
        "discovery",
        False,
        recorder_options,
    )
    discovery: dict[str, Any] = {
        "startedAt": utc_now_iso(),
        "clientCommand": client_command,
        "bridgeStatePath": str(bridge_state_path),
        "workerDir": str(worker_dir),
        "gameDir": str(game_dir),
        "clientPid": client.process.pid,
    }
    bridge: BridgeState | None = None
    try:
        bridge, status = wait_for_title_bridge(client, bridge_state_path, launch_started_ms, args.bridge_timeout_seconds)
        discovery["minecraftProcessId"] = bridge.process_id
        discovery["initialStatus"] = status
        scenarios_payload = bridge_json(bridge, "GET", "/v1/evaluation/scenarios", timeout_seconds=10)
        discovery["scenariosPayload"] = scenarios_payload
        return list(scenarios_payload.get("scenarios", [])), discovery
    finally:
        if bridge is None:
            bridge = read_bridge_state(bridge_state_path)
        discovery["clientExit"] = stop_client(
            client,
            args.client_stop_timeout_seconds,
            bridge.process_id if bridge is not None else -1,
        )
        bridge_state_path.unlink(missing_ok=True)
        discovery["finishedAt"] = utc_now_iso()
        write_json(run_dir / "discovery.json", discovery)


def run_scenario(
    repo_root: Path,
    scenario_root: Path,
    worker: ScenarioWorker,
    client_command: str,
    args: argparse.Namespace,
    keep_client_after_scenario: bool,
    cancellation: threading.Event,
    recorder_options: RecorderOptions,
) -> dict[str, Any]:
    scenario = worker.scenario
    scenario_id = str(scenario["id"])
    scenario_dir = worker.scenario_dir
    scenario_dir.mkdir(parents=True, exist_ok=True)
    bridge_state_path = worker.bridge_state_path
    copy_scenario_config(scenario_root, scenario_id, scenario_dir / "scenario.yml")

    summary: dict[str, Any] = {
        "id": scenario_id,
        "name": scenario.get("name"),
        "index": worker.index,
        "workerId": worker.worker_id,
        "startedAt": utc_now_iso(),
        "harnessStatus": "RUNNING",
        "reportStatus": None,
        "message": None,
        "clientCommand": client_command,
        "workerDir": str(worker.worker_dir),
        "gameDir": str(worker.game_dir),
        "bridgeStatePath": str(bridge_state_path),
        "keepClientAfterScenario": keep_client_after_scenario,
        "outputDir": str(scenario_dir),
        "addonSummaryPath": str(scenario_dir / "summary.json"),
        "archive": scenario_archive_metadata(scenario_root, scenario),
        "requiredMods": scenario.get("requiredMods", []),
    }
    if recorder_options.enabled:
        summary["recorderPlayPath"] = None
    write_json(scenario_dir / "harness-summary.json", summary)

    launch_started_ms = int(time.time() * 1000)
    summary["clientLaunchStartedAtEpochMillis"] = launch_started_ms
    client: ClientProcess | None = None
    bridge: BridgeState | None = None
    bridge_failures = 0

    try:
        if cancellation.is_set():
            summary["harnessStatus"] = "INTERRUPTED"
            summary["message"] = "Cancelled before client launch"
            summary["interrupted"] = True
            return summary
        if recorder_options.enabled:
            recorder_root = (scenario_dir / "recorder").resolve()
            prepare_recorder_game_directory(worker.game_dir, recorder_root)
        client = start_client(
            repo_root,
            client_command,
            scenario_dir / "client.log",
            bridge_state_path,
            worker.game_dir,
            worker.worker_id,
            True,
            recorder_options,
            detach_output=keep_client_after_scenario,
            scenario_manifest=scenario_dir / "scenario.yml",
        )
        summary["clientPid"] = client.process.pid
        write_json(scenario_dir / "harness-summary.json", summary)
        bridge, status = wait_for_title_bridge(
            client,
            bridge_state_path,
            launch_started_ms,
            args.bridge_timeout_seconds,
            cancellation,
        )
        summary["minecraftProcessId"] = bridge.process_id
        write_json(scenario_dir / "initial-status.json", status)
        run_request = {"scenario": scenario_id, "outputDir": str(scenario_dir)}
        run_response = bridge_json(
            bridge,
            "POST",
            "/v1/evaluation/run",
            run_request,
            timeout_seconds=20,
        )
        write_json(scenario_dir / "run-request.json", {
            "request": run_request,
            "response": run_response,
        })

        while True:
            if cancellation.is_set():
                summary["harnessStatus"] = "INTERRUPTED"
                summary["message"] = "Interrupted by user"
                summary["interrupted"] = True
                break
            if client.process.poll() is not None:
                summary["harnessStatus"] = "CLIENT_EXITED"
                summary["message"] = f"client exited before terminal report, code={client.process.poll()}"
                break

            collected_at = utc_now_iso()
            try:
                results = bridge_json(bridge, "GET", "/v1/evaluation/results", timeout_seconds=10)
                bridge_failures = 0
                append_jsonl(scenario_dir / "harness-polls.jsonl", {
                    "collectedAt": collected_at,
                    "kind": "evaluation_results",
                    "payload": results,
                })
                report = results.get("report", {})
                report_status = report.get("status")
                summary["reportStatus"] = report_status
                summary["message"] = report.get("message")
                summary["elapsedTicks"] = report.get("elapsedTicks")
                summary["plannerTurns"] = report.get("plannerTurns")

                if report_status in TERMINAL_STATUSES:
                    summary["harnessStatus"] = "OK"
                    break
            except Exception as error:
                bridge_failures += 1
                append_jsonl(scenario_dir / "harness-polls.jsonl", {
                    "collectedAt": collected_at,
                    "kind": "poll_error",
                    "payload": endpoint_error(error),
                })
                if bridge_failures >= 5:
                    summary["harnessStatus"] = "BRIDGE_UNAVAILABLE"
                    summary["message"] = f"bridge unavailable for {bridge_failures} consecutive polls"
                    break

            cancellation.wait(args.poll_seconds)
    except Exception as error:
        summary["harnessStatus"] = "HARNESS_ERROR"
        summary["message"] = f"{type(error).__name__}: {error}"
        write_json(scenario_dir / "harness-error.json", endpoint_error(error))
    except KeyboardInterrupt:
        summary["harnessStatus"] = "INTERRUPTED"
        summary["message"] = "Interrupted by user"
        summary["interrupted"] = True
    finally:
        if client is None:
            summary["clientExit"] = {
                "method": "NOT_STARTED",
                "finishedAt": utc_now_iso(),
            }
            summary["clientKeptRunning"] = False
        elif keep_client_after_scenario and client.process.poll() is None and not cancellation.is_set():
            summary["clientExit"] = leave_client_running(client)
            summary["clientKeptRunning"] = True
        else:
            if bridge is None:
                bridge = read_bridge_state(bridge_state_path)
            graceful_stop = (
                lambda: bridge_json(bridge, "POST", "/v1/evaluation/client-stop", timeout_seconds=10)
                if recorder_options.enabled and bridge is not None
                else None
            )
            summary["clientExit"] = stop_client(
                client,
                args.client_stop_timeout_seconds,
                bridge.process_id if bridge is not None else -1,
                graceful_stop,
            )
            summary["clientKeptRunning"] = False
        if not summary["clientKeptRunning"]:
            bridge_state_path.unlink(missing_ok=True)
        summary["bridgeStateRemoved"] = not bridge_state_path.exists()
        if recorder_options.enabled and client is not None:
            recorder_root = (scenario_dir / "recorder").resolve()
            finalize_recorder_capture(summary, scenario_dir, recorder_root)
        if should_delete_worker(summary):
            try:
                shutil.rmtree(worker.worker_dir)
                summary["workerDirectoryCleanup"] = "DELETED"
            except OSError as error:
                summary["harnessStatus"] = "CLEANUP_ERROR"
                summary["message"] = f"Failed to delete worker directory: {error}"
                summary["workerDirectoryCleanup"] = "RETAINED"
        else:
            summary["workerDirectoryCleanup"] = "RETAINED"
        summary["clientFinishedAtEpochMillis"] = int(time.time() * 1000)
        summary["finishedAt"] = utc_now_iso()
        write_json(scenario_dir / "harness-summary.json", summary)
    return summary


def write_summary_markdown(run_dir: Path, manifest: dict[str, Any]) -> None:
    lines = [
        "# Airicraft Evaluation Run",
        "",
        f"- Run id: `{manifest['runId']}`",
        f"- Started: `{manifest['startedAt']}`",
        f"- Finished: `{manifest.get('finishedAt', '')}`",
        f"- Git commit: `{manifest.get('gitCommit', '')}`",
        f"- Dirty before run: `{manifest.get('gitDirty', '')}`",
        f"- Requested jobs: `{manifest.get('jobs', '')}`",
        f"- Effective workers: `{manifest.get('effectiveWorkers', '')}`",
        f"- Stop client after scenario: `{manifest.get('stopClientAfterScenario', '')}`",
        "",
        "## Results",
        "",
        "| Scenario | Worker | Harness | Report | Worker directory | Message |",
        "| --- | --- | --- | --- | --- | --- |",
    ]
    for result in manifest.get("results", []):
        lines.append(
            "| `{id}` | `{worker}` | `{harness}` | `{report}` | `{cleanup}` | {message} |".format(
                id=result.get("id", ""),
                worker=result.get("workerId", ""),
                harness=result.get("harnessStatus", ""),
                report=result.get("reportStatus", ""),
                cleanup=result.get("workerDirectoryCleanup", ""),
                message=str(result.get("message", "")).replace("|", "\\|"),
            )
        )
    if manifest.get("skipped"):
        lines.extend(["", "## Skipped", "", "| Scenario | Reason |", "| --- | --- |"])
        for item in manifest["skipped"]:
            lines.append(f"| `{item.get('id', '')}` | `{item.get('reason', '')}` |")
    if manifest.get("keptClient"):
        kept = manifest["keptClient"]
        lines.extend([
            "",
            "## Kept Client",
            "",
            f"- Scenario: `{kept.get('scenario', '')}`",
            f"- PID: `{kept.get('pid', '')}`",
            f"- Log: `{kept.get('logPath', '')}`",
            f"- Bridge state: `{kept.get('bridgeStatePath', '')}`",
            f"- Wrapper environment: `AIRICRAFT_BRIDGE_STATE_FILE={kept.get('bridgeStatePath', '')}`",
        ])
    (run_dir / "summary.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def git_value(repo_root: Path, args: list[str]) -> str:
    try:
        result = subprocess.run(
            ["git", *args],
            cwd=repo_root,
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        return result.stdout.strip()
    except Exception:
        return ""


def run_self_test() -> None:
    test_path = repo_root_from_script() / "scripts" / "tests" / "test_run_evaluation_scenarios.py"
    completed = subprocess.run(
        [sys.executable, str(test_path)],
        cwd=repo_root_from_script(),
        check=False,
        capture_output=True,
        text=True,
    )
    if completed.returncode != 0:
        sys.stdout.write(completed.stdout)
        sys.stderr.write(completed.stderr)
        raise RunnerError(f"self-test failed with exit code {completed.returncode}")


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run Airicraft evaluator scenarios with isolated clients. The evaluator addon owns durable reports.",
    )
    parser.add_argument("--scenario", action="append", dest="scenario_filters", help="Scenario id to run. May be repeated.")
    parser.add_argument("--output-root", default="eval-output", help="Directory for ignored run bundles.")
    parser.add_argument(
        "--client-command",
        help="Command used to launch Minecraft. Defaults to scripts/eval run with only the scenario manifest requiredMods.",
    )
    parser.add_argument("--poll-seconds", type=float, default=5.0, help="Seconds between evaluation result polls.")
    parser.add_argument("--bridge-timeout-seconds", type=float, default=180.0, help="Seconds to wait for the bridge at startup.")
    parser.add_argument("--client-stop-timeout-seconds", type=float, default=45.0, help="Seconds to wait after SIGINT before SIGTERM.")
    parser.add_argument("--jobs", type=positive_int, default=1, help="Maximum concurrent scenario clients. Defaults to 1.")
    parser.add_argument(
        "--stop-client-after-scenario",
        action="store_true",
        help="Stop the scenario Minecraft client after each scenario. By default the final scenario client is left running.",
    )
    parser.add_argument(
        "--recorder-jar",
        help="Recording profile path. Overrides AIRICRAFT_RECORDER_JAR.",
    )
    parser.add_argument(
        "--no-recorder",
        action="store_true",
        help="Disable integrated-server capture for this evaluation run.",
    )
    parser.add_argument("--self-test", action="store_true", help="Run built-in unit checks and exit.")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.self_test:
        run_self_test()
        print("self-test: ok")
        return 0

    try:
        recorder_options = resolve_recorder_options(
            args.recorder_jar,
            args.no_recorder,
            os.environ,
        )
    except RunnerError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2

    repo_root = repo_root_from_script()
    client_command = args.client_command or default_client_command(repo_root)
    output_root = Path(args.output_root)
    if not output_root.is_absolute():
        output_root = repo_root / output_root
    run_id = local_timestamp()
    run_dir = output_root / run_id
    run_dir.mkdir(parents=True, exist_ok=False)
    worker_root = repo_root / "run" / "evaluator-workers" / run_id
    seed_dir = snapshot_evaluator_game_directory(repo_root, worker_root)

    manifest: dict[str, Any] = {
        "runId": run_id,
        "startedAt": utc_now_iso(),
        "repoRoot": str(repo_root),
        "clientCommand": client_command,
        "gitCommit": git_value(repo_root, ["rev-parse", "HEAD"]),
        "gitDirty": bool(git_value(repo_root, ["status", "--short"])),
        "scenarioFilters": args.scenario_filters or [],
        "jobs": args.jobs,
        "effectiveWorkers": 0,
        "workerRoot": str(worker_root),
        "stopClientAfterScenario": args.stop_client_after_scenario,
        "recorderEnabled": recorder_options.enabled,
        "recordingProfile": recorder_options.profile,
        "skipped": [],
        "results": [],
    }
    write_json(run_dir / "manifest.json", manifest)

    try:
        discovery_worker_dir = worker_root / "discovery"
        discovery_game_dir = prepare_worker_directory(seed_dir, discovery_worker_dir)
        scenarios, discovery = discover_scenarios(
            repo_root,
            run_dir,
            client_command,
            args,
            discovery_worker_dir,
            discovery_game_dir,
            recorder_options,
        )
        shutil.rmtree(discovery_worker_dir, ignore_errors=True)
        manifest["discovery"] = {
            "scenarioCount": len(scenarios),
            "scenarioRoot": discovery.get("scenariosPayload", {}).get("scenarioRoot"),
        }
        scenario_root = Path(str(discovery.get("scenariosPayload", {}).get("scenarioRoot", repo_root / "scenarios")))
        write_json(run_dir / "scenario-index.json", scenarios)
        runnable, skipped = selected_scenarios(scenarios, args.scenario_filters)
        manifest["skipped"] = skipped
        plans = worker_plans(run_dir, worker_root, seed_dir, runnable)
        shutil.rmtree(seed_dir, ignore_errors=True)
        manifest["effectiveWorkers"] = effective_worker_count(args.jobs, len(plans))
        write_json(run_dir / "manifest.json", manifest)

        interrupted = False
        cancellation = threading.Event()
        results_by_index: dict[int, dict[str, Any]] = {}

        def record_result(result: dict[str, Any]) -> None:
            nonlocal interrupted
            index = int(result["index"])
            results_by_index[index] = result
            manifest["results"] = ordered_results(results_by_index)
            if result.get("clientKeptRunning"):
                client_exit = result.get("clientExit", {})
                manifest["keptClient"] = {
                    "scenario": result.get("id"),
                    "pid": client_exit.get("pid"),
                    "logPath": client_exit.get("logPath"),
                    "bridgeStatePath": result.get("bridgeStatePath"),
                }
            write_json(run_dir / "manifest.json", manifest)
            write_summary_markdown(run_dir, manifest)
            print(f"[{index}/{len(plans)}] {result.get('id')}: {result.get('harnessStatus')} {result.get('reportStatus')}")
            if result.get("clientKeptRunning"):
                kept = result.get("clientExit", {})
                print(f"[{index}/{len(plans)}] kept client running pid={kept.get('pid')} log={kept.get('logPath')}")
            if result.get("interrupted"):
                interrupted = True

        if args.jobs == 1:
            for worker in plans:
                print(f"[{worker.index}/{len(plans)}] running {worker.scenario['id']}")
                keep_client_after_scenario = keep_client_for_scenario(
                    args,
                    worker.index,
                    len(plans),
                    recorder_options.enabled,
                )
                result = run_scenario(
                    repo_root,
                    scenario_root,
                    worker,
                    client_command,
                    args,
                    keep_client_after_scenario,
                    cancellation,
                    recorder_options,
                )
                record_result(result)
                if result.get("interrupted"):
                    break
        elif plans:
            executor = concurrent.futures.ThreadPoolExecutor(
                max_workers=manifest["effectiveWorkers"],
                thread_name_prefix="airicraft-evaluator",
            )
            futures = {
                executor.submit(
                    run_scenario,
                    repo_root,
                    scenario_root,
                    worker,
                    client_command,
                    args,
                    False,
                    cancellation,
                    recorder_options,
                ): worker
                for worker in plans
            }
            for worker in plans:
                print(f"[{worker.index}/{len(plans)}] scheduled {worker.scenario['id']}")
            try:
                for future in concurrent.futures.as_completed(futures):
                    worker = futures[future]
                    try:
                        result = future.result()
                    except Exception as error:
                        result = failed_worker_result(worker, error, recorder_options.enabled)
                    record_result(result)
            except KeyboardInterrupt:
                interrupted = True
                cancellation.set()
                for future in futures:
                    future.cancel()
            finally:
                executor.shutdown(wait=True, cancel_futures=True)
            for future, worker in futures.items():
                if worker.index in results_by_index:
                    continue
                if future.cancelled():
                    record_result(cancelled_worker_result(worker, recorder_options.enabled))
                else:
                    try:
                        result = future.result()
                    except Exception as error:
                        result = failed_worker_result(worker, error, recorder_options.enabled)
                    record_result(result)

        manifest["finishedAt"] = utc_now_iso()
        if interrupted:
            manifest["harnessStatus"] = "INTERRUPTED"
        write_json(run_dir / "manifest.json", manifest)
        write_summary_markdown(run_dir, manifest)
        try:
            worker_root.rmdir()
        except OSError:
            pass
    except KeyboardInterrupt:
        manifest["finishedAt"] = utc_now_iso()
        manifest["harnessStatus"] = "INTERRUPTED"
        write_json(run_dir / "manifest.json", manifest)
        write_summary_markdown(run_dir, manifest)
        print(f"output: {run_dir}", file=sys.stderr)
        return 130
    except Exception as error:
        manifest["finishedAt"] = utc_now_iso()
        manifest["harnessError"] = f"{type(error).__name__}: {error}"
        write_json(run_dir / "manifest.json", manifest)
        write_summary_markdown(run_dir, manifest)
        print(f"error: {manifest['harnessError']}", file=sys.stderr)
        print(f"output: {run_dir}", file=sys.stderr)
        return 2

    failed = [
        result for result in manifest["results"]
        if result.get("harnessStatus") != "OK" or result.get("reportStatus") == "FAILED"
    ]
    print(f"output: {run_dir}")
    if manifest.get("harnessStatus") == "INTERRUPTED":
        return 130
    if failed:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
