#!/usr/bin/env bash
# Exploratory: fetch the pinned Cortico (and AIRI) checkouts used by experiments/cortico-world.
# Third-party code is never vendored; it lives in the ignored .cortico-experiment/ directory.
set -euo pipefail

usage() {
	printf '%s\n' \
		'Usage: scripts/cortico-experiment <command>' \
		'' \
		'  setup [cortico|airi|all]  Fetch pinned checkouts (default: cortico), apply patches, install dependencies.' \
		'  client [world] | client stop  Launch the airicraft client (driver mode, Xvfb, software GL) and join a scenario world.' \
		'  test                      Run the World tests against the pinned Cortico.' \
		'  env                       Print the environment used to run Cortico with the airicraft World.' \
		'' \
		'Pins live in experiments/cortico-world/pins.json.'
}

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
exp_dir="$repo_root/experiments/cortico-world"
work_dir="$repo_root/.cortico-experiment"

pin() { node -e "const p=require('$exp_dir/pins.json'); console.log(p['$1']['$2'])"; }

fetch_pinned() {
	local name="$1" dir="$work_dir/$1" repo sha current
	repo="$(pin "$name" repo)"
	sha="$(pin "$name" sha)"
	mkdir -p "$dir"
	if [[ ! -d "$dir/.git" ]]; then
		git -C "$dir" init -q
		git -C "$dir" remote add origin "$repo"
	fi
	# The `pinned` tag marks the upstream commit; patches sit on top of it.
	current="$(git -C "$dir" rev-parse -q --verify 'refs/tags/pinned^{commit}' 2>/dev/null || true)"
	if [[ "$current" != "$sha" ]]; then
		if [[ -n "$(git -C "$dir" status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
			echo "error: $dir has local changes; refusing to move it to $sha" >&2
			exit 1
		fi
		GIT_LFS_SKIP_SMUDGE=1 git -C "$dir" fetch -q --depth 1 origin "$sha"
		git -C "$dir" checkout -q --detach FETCH_HEAD
		git -C "$dir" tag -f pinned FETCH_HEAD >/dev/null
		rm -f "$dir/.git/patches-applied"
	fi
	echo "$name pinned at $sha"
}

# Apply the patch series on top of `pinned`. Re-applies from scratch when the series changed.
apply_patches() {
	local name="$1" patch_dir="$exp_dir/patches/$1" dir="$work_dir/$1" want have
	compgen -G "$patch_dir/*.patch" >/dev/null || return 0
	want="$(cat "$patch_dir"/*.patch | sha256sum | cut -d' ' -f1)"
	have="$(cat "$dir/.git/patches-applied" 2>/dev/null || true)"
	[[ "$want" == "$have" ]] && { echo "$name: patches already applied"; return 0; }
	git -C "$dir" reset -q --hard pinned
	git -C "$dir" -c user.name=experiment -c user.email=experiment@invalid am -q "$patch_dir"/*.patch
	echo "$want" >"$dir/.git/patches-applied"
	echo "$name: patches applied"
}

cmd="${1:-}"
case "$cmd" in
	setup)
		target="${2:-cortico}"
		[[ "$target" == cortico || "$target" == all ]] && {
			fetch_pinned cortico
			(cd "$work_dir/cortico" && pnpm install --frozen-lockfile --ignore-scripts)
		}
		[[ "$target" == airi || "$target" == all ]] && {
			fetch_pinned airi
			apply_patches airi
		}
		(cd "$exp_dir" && pnpm install)
		;;
	client)
		# Needs JAVA_HOME at a JDK 25+, xvfb-run, and a built mod (./gradlew build). Processes do not survive a
		# container restart, so run this again after one.
		if [[ "${2:-}" == stop ]]; then
			[[ -f "$work_dir/client.pid" ]] && kill -- "-$(cat "$work_dir/client.pid")" 2>/dev/null || true
			rm -f "$work_dir/client.pid"
			exit 0
		fi
		world="${2:-pickup}"
		state_file="${AIRICRAFT_BRIDGE_STATE_FILE:-$HOME/.airicraft/bridge-state.json}"
		cli="$repo_root/wrapper/build/install/airicraft/bin/airicraft"
		mkdir -p "$work_dir" "$repo_root/run/saves"
		[[ -d "$repo_root/run/saves/$world" ]] || unzip -q "$repo_root/scenarios/$world/world.zip" -d "$repo_root/run/saves/$world"
		rm -f "$state_file"
		(cd "$repo_root" && LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe setsid nohup xvfb-run -a -s "-screen 0 1280x720x24" \
			scripts/codex-driver --max-workers=1 >"$work_dir/client.log" 2>&1 </dev/null & echo $! >"$work_dir/client.pid")
		for _ in $(seq 1 90); do [[ -f "$state_file" ]] && break; sleep 5; done
		[[ -f "$state_file" ]] || { echo "error: the client never opened its bridge; see $work_dir/client.log" >&2; exit 1; }
		sleep 20
		world_id="$("$cli" worlds list 2>/dev/null | awk -F': ' '/^worldId:/ {print $2; exit}')"
		[[ -n "$world_id" ]] || { echo "error: no saved world found" >&2; exit 1; }
		"$cli" worlds join --world-id "$world_id" >/dev/null
		for _ in $(seq 1 40); do "$cli" status 2>/dev/null | grep -q '^worldLoaded: true' && { echo "in world $world_id"; exit 0; }; sleep 3; done
		echo "error: the world did not finish loading" >&2
		exit 1
		;;
	test)
		[[ -d "$work_dir/cortico" ]] || { echo "run: scripts/cortico-experiment setup" >&2; exit 1; }
		(cd "$exp_dir" && CORTICO_SRC="$work_dir/cortico/src" pnpm test)
		;;
	env)
		printf 'CORTICO_SRC=%s\nCORTICO_EXTENSIONS_DIR=%s\n' "$work_dir/cortico/src" "$work_dir/extensions"
		;;
	-h|--help|help|"")
		usage
		;;
	*)
		usage >&2
		exit 2
		;;
esac
