# Maximum chat distance in blocks for player chat reaching the planner.
# Use -1 for unlimited distance.
socialChatMaxDistanceBlocks: -1

# When true, profileless system chat such as death and advancement messages is ingested.
readSystemChatMessages: true

# When true, nearby non-@agent chat also goes through the planner.
enableProactiveSocialMode: true

# When true, the game does not open the pause menu after the window loses focus.
suppressAutoPauseOnFocusLost: true

# Delay in client ticks between batched place_block/use_block target interactions.
# Use 0 to disable pacing.
blockInteractionDelayTicks: 2

# Spring response time in client ticks (approximate settling time, not a deadline).
# Use 0 for the default spring. All automated turns are smoothed, including Baritone.
cameraLerpDefaultTicks: 0

# Read-only realtime debug dashboard. Each Airicraft client owns one dashboard.
debugDashboard:
  enabled: true
  # The server binds on all interfaces and scans upward when this port is taken.
  basePort: 8765
  portScanLimit: 100
  # Rolling 12,000-server-tick window (10 minutes at 20 TPS), bounded by this memory cap.
  historyMegabytes: 64
  # Sparse active-client RGB; identical frames are skipped before encoding.
  visualCaptureEnabled: true
  # Completed server ticks between samples. 20 = at most 1 fps, 40 = 0.5 fps.
  visualCaptureIntervalTicks: 20
