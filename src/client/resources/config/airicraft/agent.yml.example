# Planner inference backend: openai-compatible | codex-app-server
plannerBackend: "openai-compatible"

# Local Codex app-server settings. Codex mode uses the existing local Codex login
# and does not require providerBaseUrl, apiKey, or model below.
codexAppServer:
  executable: "codex"
  # Empty uses the model selected by the local Codex configuration.
  model: ""
  # Examples: low, medium, high, xhigh. Accepted values are model-specific.
  # Empty uses the local Codex default.
  reasoningEffort: ""
  # Set to "fast" to request Codex Fast mode (higher credit consumption).
  # Empty inherits the local Codex default. Other tiers depend on the model/account.
  # After changing this setting, run /airicraft reload to start a fresh planner session.
  serviceTier: ""
  startupTimeoutMillis: 10000
  turnTimeoutMillis: 120000

# OpenAI-compatible base URL, for example: https://api.openai.com/v1
providerBaseUrl: "https://api.openai.com/v1"

# Fill in a real API key to enable live planner requests.
apiKey: ""

# Model name exposed by the configured provider.
model: ""

# Optional OpenAI-compatible reasoning_effort, e.g. low, medium, high, none.
# Empty omits the field; supported values and defaults depend on the provider/model.
# RunInfra qwen3-8-27b supports low and none (thinking off). Reload to apply.
plannerReasoningEffort: ""

# Two independent System2 sessions. Controller effort is fixed to none in this mode.
# The thinking planner takes over gameplay tools for delegate_task, then returns control.
# Empty thinking model uses the controller model; both use the same provider credentials.
# Supported with the openai-compatible backend. Reload creates fresh role sessions.
thinkingPlanner:
  enabled: false
  model: ""
  reasoningEffort: "medium"

# OpenAI-compatible base URL for vision requests.
visionProviderBaseUrl: "https://api.openai.com/v1"

# Fill in a real API key to enable live vision requests.
visionApiKey: ""

# Vision-capable model name exposed by the configured provider.
# For OpenAI, a practical default is: gpt-4.1-mini
visionModel: ""

# Planner request timeout in milliseconds.
requestTimeoutMillis: 15000

# Vision request timeout in milliseconds.
visionRequestTimeoutMillis: 10000

# Number of recent dialogue turns retained in planner context.
maxRecentConversationTurns: 8

# Trigger a context compaction checkpoint once the planner input prompt reaches this many tokens.
plannerCompactionTriggerTokens: 65536

# Maximum number of raw semantic events allowed to remain pending before planner auto-flush is triggered.
plannerPendingSemanticEventCap: 128

# Maximum number of superseded planner attempts allowed to remain in flight at once.
plannerSessionMaxConcurrentAttempts: 3

# Additional coalesce delay per queued supersede trigger after the first.
plannerSessionCoalesceStepMillis: 10

# Minimum coalesce delay once two or more queued triggers are being merged.
plannerSessionCoalesceMinMillis: 10

# Maximum coalesce delay for superseded planner replacement generations.
plannerSessionCoalesceMaxMillis: 100

# Deterministic emergency control. Normal work stays paused after the danger clears.
reflex:
  enabled: true
  lowAirTicks: 100
  # Legacy compatibility setting; combat no longer retreats at a health threshold.
  defendMinHealthRatio: 0.5
  threatCooldownTicks: 60

# Honest noticing: what the companion could actually see (no X-ray), budgeted per client tick.
# Blocks are scanned within radius; entities enter perception within entityEnterRange (with line of
# sight) and leave beyond entityExitRange. Reload applies changes.
perception:
  enabled: true
  radius: 12
  positionsPerTick: 256
  raycastsPerTick: 16
  candidatesPerStep: 50
  entityEnterRange: 16
  entityExitRange: 20

# Wait this many seconds after going idle before the first automatic idle thought.
# Set to 0 to disable automatic idle thoughts.
idleInitialDelaySeconds: 30

# After each automatic idle thought, wait at least this many seconds before another one.
# Set to 0 to disable automatic idle thoughts.
idleCooldownSeconds: 90

# Image detail hint passed to compatible multimodal providers: low | high | auto
visionImageDetail: "low"

# When true, planner visual tool follow-up attaches the captured image directly to the planner.
# When false, the visual tool uses the external vision model to summarize the screenshot first.
plannerNativeVisionEnabled: false
# Maximum native images retained in the planner context (minimum 1).
# At the limit, interpret new images with the same planner model in a fresh context
# and return text. Existing images stay unchanged; compaction restores capacity.
plannerMaxImages: 8

# Deprecated for normal planner turns. Normal planning now uses plaintext replies plus tool calls.
# Hidden compaction requests still use response_format.type=json_object.
plannerUseJsonObjectResponseFormat: true

observability:
  # Enable vendor-neutral OpenTelemetry tracing for outbound planner and vision model calls.
  enabled: false

  # Supported values today: otlp_http
  exporter: "otlp_http"

  # Generic OTLP HTTP endpoint, for example: http://127.0.0.1:4318/v1/traces
  otlpEndpoint: ""

  # Optional headers sent to the OTLP endpoint.
  otlpHeaders: {}

  # Optional OTEL resource attributes attached to every emitted span.
  resourceAttributes: {}

  # Supported values today: generic | weave
  vendorProfile: "generic"

  # When true, traces include sanitized summarized inputs rather than only counts and flags.
  captureInputs: false

  # When true, traces include sanitized summarized outputs rather than only lengths and intent/tool metadata.
  captureOutputs: false

  # When true, screenshot/tool-capture spans may export image payloads for media-capable backends like Weave.
  # Other LLM request traces still redact image bytes from logged request bodies.
  captureImages: false

  # Weave OTLP example:
  # otlpEndpoint: "https://trace.wandb.ai/otel/v1/traces"
  # otlpHeaders:
  #   wandb-api-key: "<key>"
  # resourceAttributes:
  #   wandb.entity: "shinohara-rin"
  #   wandb.project: "airicraft"
  # vendorProfile: "weave"

# Experimental sequential short-term findings for world inspection/query results.
# Requires openai-compatible. Raw results remain in debug records, not future context.
plannerSummarizeToolResults: true
